# Copy to .env and fill in. .env is git-ignored; the key stays on the server.

# Required for the "Ask the guide" chat. Without it everything else still works.
ANTHROPIC_API_KEY=

# Model used for chat answers. Change it without touching code.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: reasoning effort (low | medium | high | xhigh | max, or "none" to omit).
# Defaults to low, which suits short chat answers.
# ANTHROPIC_EFFORT=low

# Optional: set to "off" to disable the server-side refusal fallback.
# ANTHROPIC_FALLBACKS=on

# Optional: port for the dev/production server (default 5173).
# PORT=5173

# Optional: set to 1 when running behind a reverse proxy so rate limits see real client IPs.
# TRUST_PROXY=1
