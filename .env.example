# Required: your Claude API key (https://platform.claude.com)
ANTHROPIC_API_KEY=

# Character
COMPANION_NAME=Aria
COMPANION_USER_NAME=Bradley

# Model settings. Lower effort = faster replies.
COMPANION_MODEL=claude-opus-5
COMPANION_EFFORT=medium

# Server. Keep HOST=127.0.0.1 unless you set COMPANION_ACCESS_TOKEN.
PORT=3000
HOST=127.0.0.1
# Required if you expose the server beyond localhost: anyone with this token
# can use your connected tools.
COMPANION_ACCESS_TOKEN=

# Tokens referenced from mcp-servers.json as ${NAME}
GITHUB_MCP_TOKEN=
NOTION_MCP_TOKEN=
GMAIL_MCP_TOKEN=
GCAL_MCP_TOKEN=
